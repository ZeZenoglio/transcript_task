# Copy to .env and fill in. .env is gitignored and must never be committed.

# GitHub personal access token, used only for local `gh` / CI bootstrap work.
# Scopes needed: repo, workflow. Prefer `gh auth login` over storing this.
GITHUB_ACCESS_PAT=

# Ollama endpoint. Defaults to the local daemon if unset.
OLLAMA_HOST=http://localhost:11434

# Optional: Hugging Face token. Only needed for gated datasets; FLEURS is public,
# but a token raises the download rate limit.
HF_TOKEN=
