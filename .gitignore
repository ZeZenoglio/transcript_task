# ---------------------------------------------------------------------------
# Secrets  --  keep this block first; nothing here may ever reach the remote.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
.streamlit/secrets.toml

# ---------------------------------------------------------------------------
# Private source material
# ---------------------------------------------------------------------------
# Real recordings and anything derived from them. This repo is public; audio
# and transcripts of real people must stay local. Test fixtures are explicitly
# re-included at the bottom of this file.
Arquivo.zip
*.zip
tmp/
output/
data/

*.m4a
*.opus
*.mp3
*.wav
*.ogg
*.flac
*.aac
*.wma
*.amr
*.m4b
*.docx

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info/
.venv/
venv/

# ---------------------------------------------------------------------------
# Tooling caches and reports
# ---------------------------------------------------------------------------
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.log
logs/

# ---------------------------------------------------------------------------
# Runtime artifacts
# ---------------------------------------------------------------------------
mlruns/
mlartifacts/
# Exception: the CI regression baseline (Phase 11) -- a small, committed
# JSON+markdown snapshot of one real quick-tier run against the current
# default config, so benchmark.yml's compare step has something fixed to
# diff every push against, without needing a tracking server reachable
# from CI. Everything else under benchmarks/ stays local-only. Git can't
# re-include a path under an already-ignored directory, so this ignores
# benchmarks/'s *contents* (`benchmarks/*`) rather than the directory
# itself, which is what makes the negation below actually work.
benchmarks/*
!benchmarks/main-baseline/
*.db
*.sqlite
*.sqlite3

# ---------------------------------------------------------------------------
# Editors and OS
# ---------------------------------------------------------------------------
.DS_Store
.idea/
*.swp
.claude/settings.local.json

# ---------------------------------------------------------------------------
# Re-include committed test fixtures
# ---------------------------------------------------------------------------
# A small, diversified subset of the public CC-BY FLEURS benchmark (Phase 4) --
# not synthetic, but public-domain-license and containing no real person's
# recording. These are the only audio files allowed in the repository.
!tests/fixtures/
!tests/fixtures/**/*.wav
!tests/fixtures/**/*.m4a
!tests/fixtures/**/*.opus
!tests/fixtures/**/*.mp3
!tests/fixtures/**/*.json
!tests/fixtures/**/*.jsonl
!tests/fixtures/**/*.md

# A small, diversified subset of Common Voice pt (Phase 6, "noisier" tier) --
# CC0-1.0, contributors' recordings voluntarily donated to the public
# Mozilla Common Voice corpus specifically for reuse like this.
!tests/fixtures_noisy/
!tests/fixtures_noisy/**/*.wav
!tests/fixtures_noisy/**/*.m4a
!tests/fixtures_noisy/**/*.opus
!tests/fixtures_noisy/**/*.mp3
!tests/fixtures_noisy/**/*.json
!tests/fixtures_noisy/**/*.jsonl
!tests/fixtures_noisy/**/*.md
